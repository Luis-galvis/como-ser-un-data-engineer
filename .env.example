# =============================================================================
# VARIABLES DE ENTORNO DEL LABORATORIO LOCAL
# 'Cómo ser un Data Engineer' - Repositorio Oficial
# =============================================================================
# Copia este archivo a '.env' antes de ejecutar docker compose:
# cp .env.example .env

# --- PostgreSQL (Base OLTP) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_DB=data_engineer_db
POSTGRES_PORT=5432

# --- MinIO (Almacenamiento de Objetos S3 Local) ---
MINIO_ROOT_USER=admin_minio
MINIO_ROOT_PASSWORD=minio_secret_key_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Configuración AWS CLI / S3 para DuckDB y PySpark ---
AWS_ACCESS_KEY_ID=admin_minio
AWS_SECRET_ACCESS_KEY=minio_secret_key_2026
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000

# --- Apache Spark ---
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8080
